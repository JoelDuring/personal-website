---
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { formatDate, getWriting, readingMinutes } from '../../lib/writing';

export async function getStaticPaths() {
  return (await getWriting()).map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'writing'>;
}
const { post } = Astro.props;
const { title, description, pubDate, category } = post.data;
const { Content } = await render(post);
---
<Layout title={title} description={description} published={pubDate} category={category} reading>
  <article>
    <header class="article-heading">
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <div class="metadata">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span>{readingMinutes(post.body)} min read</span>
        {category && <span>{category}</span>}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Layout>
