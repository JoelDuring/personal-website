---
import Layout from '../../layouts/Layout.astro';
import { articlePath, getWriting } from '../../lib/writing';

const posts = await getWriting();
---
<Layout title="Writing" description="Writing by Joël During.">
  <h1>Writing</h1>
  {posts.length ? (
    <ul class="article-list">
      {posts.map(({ id, data }) => (
        <li>
          <time datetime={data.pubDate.toISOString()}>{data.pubDate.toISOString().slice(0, 10)}</time>
          <div class="article-entry">
            <a href={articlePath(id)}>{data.title}</a>
            <p>{data.description}</p>
          </div>
          {data.category && <span class="article-category">{data.category}</span>}
        </li>
      ))}
    </ul>
  ) : (
    <p class="lede">No articles yet.</p>
  )}
</Layout>
