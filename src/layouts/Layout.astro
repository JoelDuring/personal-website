---
import { site } from '../site.mjs';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
  published?: Date;
  category?: string;
  reading?: boolean;
}

const { title, description = site.description, published, category, reading } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | AI engineer and tech lead`;
const links = [
  { href: '/about/', label: 'About' },
  { href: '/writing/', label: 'Writing' },
  { href: '/rss.xml', label: 'RSS' },
];
const canonical = new URL(Astro.url.pathname, site.origin);
const image = new URL(site.socialImage, site.origin);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={published ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={image.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Joël During, AI engineer and tech lead" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} | Writing`} href="/rss.xml" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {category && <meta property="article:section" content={category} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/">joelduring.com</a>
        <nav aria-label="Main">
          {links.map(({ href, label }) => (
            <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1" class:list={['shell', { reading }]}>
      <slot />
    </main>
  </body>
</html>
